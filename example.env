# Remittal template: copy to .env.local when configuring services.
# Next.js does not load example.env. Never put real credentials in this template.
# Leave unavailable services blank; the starter requires no cloud credentials.

# Neon PostgreSQL: separate development database, TLS connection string.
DATABASE_URL=

# Better Auth: generate a random secret of at least 32 characters.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Private S3: environment-specific bucket and narrowly scoped credentials.
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Trigger.dev: environment-specific secret key.
TRIGGER_SECRET_KEY=

# Sentry: optional locally; SDK setup is deferred.
SENTRY_DSN=

# Add additional SDK keys when their integrations are implemented and documented.
# Never expose service credentials as NEXT_PUBLIC_ variables.
